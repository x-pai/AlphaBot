# 应用配置
APP_NAME="AI Stock Assistant API"
API_V1_STR="/api/v1"
APP_PUBLIC_BASE_URL=""
APP_TIMEZONE="Asia/Shanghai"
APP_CIPHER_KEY_MATERIAL="alphabot-client-payload-v1"

# 数据源配置
# 可选值: "alphavantage", "tushare", "akshare", "hk_stock", "tdx"
DEFAULT_DATA_SOURCE="akshare"
DEFAULT_MARKET_DATA_SOURCE="xgb"
MARKET_DATA_BINDINGS=""
# 设置 tdxaidata 全量切换市场数据；MARKET_DATA_BINDINGS 不得混用旧来源。
# 真实 Key 仅写入受限的本地 .env 或部署环境，不要提交。
TDXAIDATA_TOKEN=""
TDXAIDATA_LIB_DIR=""
TDXAIDATA_TIMEOUT=30
TDXAIDATA_MAX_PENDING=8
TDXAIDATA_MAX_SYMBOLS=100
XGB_FLASH_API_BASE="https://flash-api.xuangubao.com.cn/api"
XGB_DDC_MARKET_API_BASE="https://api-ddc-wscn.xuangubao.com.cn/market"
XGB_TREND_API_BASE="https://baoer-api.xuangubao.com.cn/api"
XGB_REFERER="https://www.xuangubao.cn/"

# Alpha Vantage API配置
ALPHAVANTAGE_API_BASE_URL="https://www.alphavantage.co/query"
ALPHAVANTAGE_API_KEY="your_alphavantage_api_key"

# Tushare API配置
TUSHARE_API_TOKEN="your_tushare_api_token"

# AKShare配置
AKSHARE_USE_PROXY=False
AKSHARE_PROXY_URL=""

# 雪球配置（用于AKShare的部分接口）
XUEQIU_TOKEN="your_xueqiu_token"

# TDX 配置
TDX_API_BASE_URL="http://your-tdx-api-host"
TDX_TIMEOUT=10

# 世界杯专题配置（Polymarket / ESPN 默认可用；其他数据源按需启用）
WORLDCUP_POLYMARKET_ENABLED=True
WORLDCUP_POLYMARKET_API_BASE="https://gamma-api.polymarket.com"
WORLDCUP_POLYMARKET_LIMIT=500
WORLDCUP_POLYMARKET_USE_PROXY=False
WORLDCUP_POLYMARKET_PROXY_URL=""
WORLDCUP_SCHEDULE_API_BASE="https://site.api.espn.com/apis/site/v2/sports/soccer/fifa.world"
WORLDCUP_SCHEDULE_START_DATE="2026-06-11"
WORLDCUP_SCHEDULE_END_DATE="2026-07-19"

# 数据库配置
DATABASE_URL="sqlite:///./stock_assistant.db"

# 安全配置
SECRET_KEY="your-secret-key-for-production"

# AI分析配置
# 可选值: "rule", "ml", "llm"
DEFAULT_ANALYSIS_MODE="rule"

# AI模型配置
AI_MODEL_PATH="./models/stock_analysis_model.pkl"

# LLM 配置（LiteLLM 统一接口）
# 模型格式：provider/model_name，如 openai/gpt-4o-mini、deepseek/deepseek-chat、anthropic/claude-3-5-sonnet
LLM_MODEL="openai/gpt-4o-mini"
LLM_API_KEY="your_api_key"
LLM_API_BASE="https://api.openai.com/v1"
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.7
# 可选：逗号分隔的可用模型列表，供前端切换
LLM_AVAILABLE_MODELS=openai/gpt-4o-mini,openai/gpt-4o

# 向量检索 / 长期记忆配置（Chroma + Embedding）
# 默认使用 OpenAI 兼容 embedding
EMBEDDING_MODEL="text-embedding-3-small"
# 可选：单独为向量检索配置 provider，不填则回退到 LLM_API_BASE / LLM_API_KEY
EMBEDDING_API_BASE=""
EMBEDDING_API_KEY=""

# 可选：为不同角色指定专用模型（未配置则回退到上面的 LLM_*）
# LLM_DEFAULT_MODEL="openai/gpt-4o-mini"
# LLM_RESEARCH_MODEL="openai/gpt-4o-mini"
# LLM_RISK_MODEL="openai/gpt-4o-mini"

# 消息渠道 / 系统共用机器人
# 凭证仅保存在服务端；个人账号绑定在「系统管理 → 消息渠道 → 个人渠道管理」操作。
# 修改配置后重启后端。开关控制该渠道的入站与出站。

# QQ：默认关闭，使用 WebSocket，无需公网回调
QQ_BOT_ENABLED=false
QQ_BOT_APP_ID=""
QQ_BOT_APP_SECRET=""
# 单机多进程共享此锁；多容器需共享锁卷或仅启用一个接收实例。
QQ_BOT_LOCK_PATH=/tmp/alphabot-qq.lock

# Telegram：默认长轮询，无需公网回调
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=""
# 仅使用 webhook 时配置，与平台 secret_token 一致；配置后不启动轮询。
TELEGRAM_WEBHOOK_SECRET=""

# 飞书：事件回调，需配置校验 Token 或加密 Key
FEISHU_ENABLED=true
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""
FEISHU_API_BASE="https://open.feishu.cn"
FEISHU_VERIFICATION_TOKEN=""
FEISHU_ENCRYPT_KEY=""

# 自定义 Webhook 推送：地址由个人渠道管理维护
WEBHOOK_ENABLED=true

# CORS配置
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://frontend:3000", "http://backend:8000"]

# Redis和Celery配置
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0 

# 搜索引擎配置（2000积分可用）
# 可选值：serpapi, googleapi, bingapi
# SEARCH_API_ENABLED=True
# SEARCH_ENGINE=serpapi
# SERPAPI_API_KEY=你的SerpAPI密钥
